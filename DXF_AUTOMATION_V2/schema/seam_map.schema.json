{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "seam_map",
  "type": "object",
  "required": ["style", "seams"],
  "properties": {
    "style": { "type": "string" },
    "seam_count": { "type": "integer" },
    "seams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "pattern_a", "edge_a", "pattern_b", "edge_b", "type", "verified"],
        "properties": {
          "id": { "type": "string" },
          "pattern_a": { "type": ["string", "array"], "items": { "type": "string" }, "description": "one pattern, or a list for M:N side A" },
          "edge_a": { "type": ["string", "array"], "items": { "type": "string" } },
          "pattern_b": { "type": ["string", "array", "null"], "items": { "type": "string" }, "description": "one pattern, or a list for 1:N / M:N side B" },
          "edge_b": { "type": ["string", "array", "null"], "items": { "type": "string" } },
          "type": { "type": "string", "enum": ["1:1", "1:2", "1:3", "1:4", "1:N", "M:N"] },
          "direction_a": { "type": "string", "enum": ["forward", "reverse"] },
          "direction_b": { "type": "string", "enum": ["forward", "reverse"] },
          "gathering_ratio": { "type": "number", "description": "1.0 = no gather; <1 or >1 = gather/ease on the longer side" },
          "expected_length_mm": {
            "type": "object",
            "description": "a/b for 1:1; a/b_total for 1:N / M:N",
            "properties": {
              "a": { "type": ["number", "null"] },
              "b": { "type": ["number", "null"] },
              "b_total": { "type": "number" }
            }
          },
          "tolerance_mm": { "type": "number" },
          "verified": { "type": "boolean", "description": "true only if geometry (or human) confirmed; needs_clo/uncertain -> false" },
          "source": { "type": "string", "enum": ["geometry", "required_added", "needs_clo", "human"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}
